<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App & Navigation Bar (Padded safely below camera cutout / notch) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ConKey"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"/>

        <!-- Interactive Connection Status Pill -->
        <LinearLayout
            android:id="@+id/pillDevice"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_btn_accent"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Searching Laptop..."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Settings & Network Selection Button -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn"
            android:text="⚙"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Direct Smart Typing Bar (Phone Keyboard + Voice Dictation) -->
    <LinearLayout
        android:id="@+id/typingBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surface"
        android:paddingHorizontal="10dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etTextInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Type or dictate using phone keyboard..."
            android:imeOptions="actionSend"
            android:inputType="text|textMultiLine"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSendText"
            android:layout_width="58dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_accent"
            android:text="Send"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Virtual Keyboard, Hotkeys & Touchpad (WebView) -->
    <WebView
        android:id="@+id/webViewKeyboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg" />

</LinearLayout>
